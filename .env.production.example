# ==============================================================================
# TodoApp API - Canlı Ortam (Production) Ortam Değişkenleri Şablonu
# ==============================================================================
# Bu dosya, canlıya (Render, Azure Container Apps, Railway, Docker vb.) çıkarken
# tanımlanması gereken çevre değişkenlerini (Environment Variables) içerir.
#
# GÜVENLİK UYARISI:
# Bu dosyayı doğrudan düzenleyip şifrelerinizi içine yazarak git'e commit ETMEYİN!
# Kendi gizli değerlerinizle '.env.production' adında yeni bir dosya oluşturun
# veya barındırma platformunun (Render/Azure) Environment Secrets paneline girin.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ASP.NET Core Temel Ayarları
# ------------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTP_PORTS=8080

# ------------------------------------------------------------------------------
# 2. Veritabanı Bağlantısı (SQL Server / Azure SQL)
# ------------------------------------------------------------------------------
# Azure SQL Database (Free Tier / Serverless) Örneği:
# ConnectionStrings__DefaultConnection="Server=tcp:todoapp-sql.database.windows.net,1433;Initial Catalog=TodoAppDb;Persist Security Info=False;User ID=sqladmin;Password=YourSuperSecurePassword123!;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;"
#
# Kendi Docker veya Bağımsız Sunucu SQL Server Örneği:
ConnectionStrings__DefaultConnection="Server=your-db-host,1433;Database=TodoAppDb;User Id=sa;Password=YourStrongPassword123!;TrustServerCertificate=False;Encrypt=True;"

# ------------------------------------------------------------------------------
# 3. JWT (JSON Web Token) Güvenlik Ayarları
# ------------------------------------------------------------------------------
# Key: En az 32 karakter (tercihen 64+ karakter) rastgele ve tahmin edilemez olmalıdır.
# PowerShell ile üretmek için: [Convert]::ToBase64String((1..64 | ForEach-Object { Get-Random -Maximum 256 }))
Jwt__Key=REPLACE_WITH_A_SECURE_64_CHAR_RANDOM_KEY_GENERATED_FOR_PRODUCTION
Jwt__Issuer=TodoApp
Jwt__Audience=TodoAppUser
Jwt__ExpiryMinutes=60
Jwt__RefreshTokenExpiryDays=7

# ------------------------------------------------------------------------------
# 4. Şifre Sıfırlama (Password Reset) Ayarları
# ------------------------------------------------------------------------------
# ResetUrl: Canlıdaki React/Vue/Angular veya mobil frontend uygulamanızın şifre sıfırlama sayfası adresi
PasswordReset__ExpiryMinutes=60
PasswordReset__ResetUrl=https://your-frontend-domain.com/reset-password

# ------------------------------------------------------------------------------
# 5. E-Posta Gönderim (SMTP) Ayarları
# ------------------------------------------------------------------------------
# Örnek: SendGrid, Brevo, Resend, Gmail SMTP vb.
Smtp__Host=smtp.your-email-provider.com
Smtp__Port=587
Smtp__FromName=TodoApp Destek
Smtp__FromEmail=noreply@yourdomain.com
Smtp__Username=your-smtp-username-or-api-key
Smtp__Password=your-smtp-password-or-secret-key

# ------------------------------------------------------------------------------
# 6. CORS (Cross-Origin Resource Sharing) İzin Verilen Alan Adları
# ------------------------------------------------------------------------------
# API'ye istek atmasına izin verilen canlı frontend domain'leri (virgül veya index formatı):
Cors__AllowedOrigins__0=https://your-frontend-domain.com
Cors__AllowedOrigins__1=https://www.your-frontend-domain.com

# ------------------------------------------------------------------------------
# 7. Log Seviyesi (Serilog)
# ------------------------------------------------------------------------------
Serilog__MinimumLevel__Default=Information
Serilog__MinimumLevel__Override__Microsoft=Warning
Serilog__MinimumLevel__Override__Microsoft.AspNetCore=Warning
Serilog__MinimumLevel__Override__Microsoft.EntityFrameworkCore=Warning

